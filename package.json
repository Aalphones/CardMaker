{
  "name": "cardmaker",
  "private": true,
  "scripts": {
    "prepare": "husky"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3"
  },
  "lint-staged": {
    "frontend/**/*.{ts,html,scss}": [
      "prettier --write"
    ],
    "backend/**/*.php": [
      "php backend/vendor/bin/php-cs-fixer fix --config=backend/.php-cs-fixer.php"
    ]
  }
}
