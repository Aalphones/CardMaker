# Kopiere diese Datei nach "deploy.env" und trage deine Werte ein.
# deploy.env landet NICHT im Git — sie enthaelt Klartext-Zugangsdaten.
#
# Sonderzeichen im Passwort: WinSCP bekommt die Zugangsdaten als Adresse. Enthaelt das
# Passwort eines von @ : / # ? % dann prozentkodiert eintragen (@ wird %40, : wird %3A,
# / wird %2F, # wird %23, ? wird %3F, % wird %25). Am einfachsten: ein Passwort ohne
# diese Zeichen waehlen.

# ── Hochladen ────────────────────────────────────────────────────────────────
# Pfad zur portablen WinSCP-Konsole (nicht WinSCP.exe, sondern WinSCP.com).
WINSCP_PATH=C:\Tools\WinSCP\WinSCP.com

# sftp oder ftp. Bietet dein Strato-Paket kein SFTP: hier ftp eintragen, dann wird
# SFTP_HOSTKEY nicht gebraucht und darf leer bleiben.
SFTP_PROTOCOL=sftp
SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=

# Nur bei sftp noetig. Beim ersten Mal: WinSCP von Hand starten, verbinden, den
# angezeigten Fingerabdruck kopieren (Form: ssh-ed25519 256 SHA256:....) und hier
# einsetzen. Kein Stern als Platzhalter — der wuerde jeden Server akzeptieren, der
# sich fuer deinen ausgibt.
SFTP_HOSTKEY=

# Zielverzeichnisse auf dem Server, wie sie nach dem Anmelden sichtbar sind.
REMOTE_API_PATH=/api/
REMOTE_APP_PATH=/

# Ausgabeordner des Frontend-Builds. Erst ab Phase 5 relevant; Angular hat den Pfad
# ueber die Versionen mehrfach geaendert — nach dem ersten Build einmal nachsehen.
FRONTEND_DIST=frontend\dist\frontend\browser

# ── Wird nach backend/.env geschrieben ───────────────────────────────────────
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Lange Zufallsfolge. Schuetzt /api/migrate und /diag.php.
MIGRATE_TOKEN=

CORS_ORIGINS=http://localhost:4200
PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=8388608
