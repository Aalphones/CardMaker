# Kopiere diese Datei nach "deploy.env" und trage deine Werte ein.
# deploy.env landet NICHT im Git — sie enthaelt Klartext-Zugangsdaten.
#
# Sonderzeichen im Passwort sind in Ordnung und muessen nicht umgeschrieben werden -
# das Skript reicht Benutzer und Passwort als eigene Angaben an WinSCP weiter, nicht
# als Teil einer Adresse. Belegt fuer | # / : ( + - ! & < im Trockenlauf.
# Einzige Ausnahme: ein doppeltes Anfuehrungszeichen (") im Passwort geht nicht.

# ── Hochladen ────────────────────────────────────────────────────────────────
# Pfad zur portablen WinSCP-Konsole (nicht WinSCP.exe, sondern WinSCP.com).
WINSCP_PATH=C:\Tools\WinSCP\WinSCP.com

# sftp oder ftp. Bietet dein Strato-Paket kein SFTP: hier ftp eintragen, dann wird
# SFTP_HOSTKEY nicht gebraucht und darf leer bleiben.
SFTP_PROTOCOL=sftp
SFTP_HOST=
SFTP_USER=
SFTP_PASSWORD=

# Nur bei sftp noetig. Format ohne "SHA256:"-Praefix, genau so wie WinSCP es meldet:
#   ssh-ed25519 255 1gx2w8Rtv3wCgi7Jh8myf...
# So kommst du dran: WinSCP von Hand verbinden, dann Strg+I ("Server- und
# Protokollinformationen") und den Fingerabdruck kopieren. Alternativ einmal mit
# irgendeinem Wert hier starten — WinSCP bricht ab und nennt den echten Abdruck.
# Kein Stern als Platzhalter — der wuerde jeden Server akzeptieren, der sich fuer
# deinen ausgibt.
SFTP_HOSTKEY=

# Zielverzeichnisse auf dem Server, wie sie nach dem Anmelden sichtbar sind.
#
# REMOTE_WEB_PATH ist der Ordner, den der Webserver ausliefert - dort landet die
# Oberflaeche. REMOTE_BACKEND_PATH liegt bewusst DANEBEN und nicht darin: so sind
# .env, Programmcode und vendor/ ueber keine Adresse erreichbar. Im Webbereich
# steht nur eine Bruecke aus drei Dateien, unter dem Namen aus API_URL_SEGMENT.
REMOTE_WEB_PATH=/public/
REMOTE_BACKEND_PATH=/backend/
API_URL_SEGMENT=api

# Pfad zu Composer. Ohne diesen Wert wird ein vorhandenes backend\vendor
# unveraendert hochgeladen; fehlt auch das, bricht das Skript ab.
COMPOSER_PATH=

# Ausgabeordner des Frontend-Builds. Erst ab Phase 5 relevant; Angular hat den Pfad
# ueber die Versionen mehrfach geaendert — nach dem ersten Build einmal nachsehen.
FRONTEND_DIST=frontend\dist\frontend\browser

# ── Wird nach backend/.env geschrieben ───────────────────────────────────────
DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Lange Zufallsfolge. Schuetzt /api/migrate und /diag.php.
MIGRATE_TOKEN=

CORS_ORIGINS=http://localhost:4200
PUBLIC_BASE_URL=
UPLOAD_MAX_BYTES=8388608
