# Wird von deploy.cmd aus deploy.env erzeugt und hochgeladen — nicht von Hand pflegen.
# Diese Datei dokumentiert nur, welche Schlüssel das Backend erwartet.

DB_HOST=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Schützt /api/migrate und /diag.php. Lange Zufallsfolge, kein sprechendes Wort.
MIGRATE_TOKEN=

# Erlaubte Herkünfte der Weboberfläche, mit Komma getrennt.
CORS_ORIGINS=http://localhost:4200

# Öffentliche Adresse der API, ohne Schrägstrich am Ende.
PUBLIC_BASE_URL=

# Obergrenze für Bild-Uploads in Bytes. Größer als upload_max_filesize auf dem
# Server zu setzen bringt nichts — der Wert steht in /diag.php.
UPLOAD_MAX_BYTES=8388608
