# ── Dependencies ────────────────────────────────────────────────────────────
vendor/
node_modules/
mcp/.venv/

# ── Python (MCP-Server) ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/

# ── Build output ─────────────────────────────────────────────────────────────
deploy/
frontend/dist/
frontend/.angular/

# ── Environment & secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example
deploy.env
.cm_token
mcp/.cm_token
mcp/cardmaker_mcp/.cm_token

# ── Scratch ──────────────────────────────────────────────────────────────────
