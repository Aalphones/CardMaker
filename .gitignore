# ── PHP ──────────────────────────────────────────────────────────────────────
backend/storage/logs/*
!backend/storage/logs/.gitkeep
*.log
backend/uploads/*
!backend/uploads/.gitkeep

# ── Claude Code (local/personal settings only) ───────────────────────────────
